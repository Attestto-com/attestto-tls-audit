{
  "name": "@attestto/tls-audit",
  "version": "0.1.0",
  "description": "Web TLS/SSL certificate classifier (CA, free-vs-paid, DV/OV/EV, expiry) with a Node-only live-certificate fetcher.",
  "homepage": "https://attestto.org",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "gate-self-test": "node scripts/gate-self-test.mjs"
  },
  "keywords": [
    "tls",
    "ssl",
    "certificate",
    "webpki",
    "dv",
    "ov",
    "ev",
    "audit"
  ],
  "author": "Attestto <hello@attestto.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@attestto/x509-core": "^0.1.0",
    "@attestto/trust": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.5.2",
    "eslint": "^9.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Attestto-com/attestto-tls-audit.git"
  },
  "gateSelfTest": {
    "workflow": ".github/workflows/ci.yml",
    "testScript": "test",
    "buildScript": "build",
    "gates": [
      {
        "name": "lint",
        "script": "lint",
        "seed": "src/__gate-self-test__.ts",
        "content": "export function seeded(): void {\n  const unused = 1\n  Promise.resolve().then(() => undefined)\n}\n"
      },
      {
        "name": "test",
        "script": "test",
        "seed": "tests/__gate-self-test__.spec.ts",
        "content": "import { it, expect } from 'vitest'\nit('is a deliberate failure', () => { expect(1).toBe(2) })\n"
      }
    ]
  }
}
